# --- OneBusAway (Puget Sound regional API) ---
# Request a real key by emailing oba_api_key@soundtransit.org. "TEST" works for
# limited development use until the real key arrives.
OBA_BASE_URL=https://api.pugetsound.onebusaway.org
OBA_API_KEY=TEST

# --- Caching + analytics storage ---
CACHE_TTL_MS=5000
# Upstash Redis (Vercel Marketplace). Powers both the vehicle snapshot cache and
# the /analytics dashboard. Leave blank for a per-instance in-memory store —
# fine for local dev, but analytics numbers are then ephemeral and not shared
# across serverless instances, so configure this for durable production stats.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Client (inlined at build time) ---
NEXT_PUBLIC_BASEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
NEXT_PUBLIC_POLL_MS=5000

# --- Washington State Ferries (WSDOT) ---
# The vessellocations API is currently open; set an access code only if WSDOT
# starts requiring one (register at https://www.wsdot.wa.gov/traffic/api/).
# WSDOT_API_ACCESS_CODE=
# WSF_BASE_URL=https://www.wsdot.wa.gov/ferries/api/vessels/rest
