# --- OneBusAway (Puget Sound regional API) ---
# Request a real key by emailing oba_api_key@soundtransit.org. "TEST" works for
# limited development use until the real key arrives.
OBA_BASE_URL=https://api.pugetsound.onebusaway.org
OBA_API_KEY=TEST

# --- Data mode ---
# USE_MOCK=1 serves synthetic vehicles (no upstream calls). Leave unset to use
# real feeds. MOCK_FALLBACK=0 disables the "show mock if all feeds fail" safety net.
USE_MOCK=1
# MOCK_FALLBACK=1

# --- Caching ---
CACHE_TTL_MS=5000
# Upstash Redis (Vercel Marketplace). Leave blank for a per-instance memory cache.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Client (inlined at build time) ---
NEXT_PUBLIC_BASEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
NEXT_PUBLIC_POLL_MS=5000

# --- Phase 5: Washington State Ferries (WSDOT) ---
# WSDOT_API_ACCESS_CODE=
